name: "t5gemma_tts"
platform: "ensemble"
max_batch_size: 1

input [ { name: "TEXT" data_type: TYPE_STRING dims: [ 1 ] } ]
input [ { name: "LANGUAGE" data_type: TYPE_STRING dims: [ 1 ] optional: true } ]
input [ { name: "TOP_K" data_type: TYPE_INT32 dims: [ 1 ] optional: true } ]
input [ { name: "TOP_P" data_type: TYPE_FP32 dims: [ 1 ] optional: true } ]
input [ { name: "TEMPERATURE" data_type: TYPE_FP32 dims: [ 1 ] optional: true } ]

output [ { name: "AUDIO_WAVEFORM" data_type: TYPE_FP32 dims: [ 1, -1 ] } ]

ensemble_scheduling {
  step [
    {
      model_name: "tokenizer"
      model_version: -1
      input_map {
        key: "TEXT"
        value: "TEXT"
      }
      input_map {
        key: "LANGUAGE"
        value: "LANGUAGE"
      }
      output_map {
        key: "INPUT_IDS"
        value: "input_ids"
      }
      output_map {
        key: "ATTENTION_MASK"
        value: "attention_mask"
      }
      output_map {
        key: "TEXT_LENGTH"
        value: "text_length"
      }
      output_map {
        key: "TARGET_DURATION"
        value: "target_duration"
      }
    },
    {
      model_name: "encoder"
      model_version: -1
      input_map {
        key: "input_ids"
        value: "input_ids"
      }
      input_map {
        key: "attention_mask"
        value: "attention_mask"
      }
      output_map {
        key: "encoder_hidden_states"
        value: "encoder_hidden_states"
      }
    },
    {
      model_name: "decoder_loop"
      model_version: -1
      input_map {
        key: "ENCODER_HIDDEN_STATES"
        value: "encoder_hidden_states"
      }
      input_map {
        key: "ENCODER_ATTENTION_MASK"
        value: "attention_mask"
      }
      input_map {
        key: "TEXT_LENGTH"
        value: "text_length"
      }
      input_map {
        key: "TARGET_DURATION"
        value: "target_duration"
      }
      input_map {
        key: "TOP_K"
        value: "TOP_K"
      }
      input_map {
        key: "TOP_P"
        value: "TOP_P"
      }
      input_map {
        key: "TEMPERATURE"
        value: "TEMPERATURE"
      }
      output_map {
        key: "AUDIO_TOKENS"
        value: "audio_tokens"
      }
    },
    {
      model_name: "vocoder"
      model_version: -1
      input_map {
        key: "codes"
        value: "audio_tokens"
      }
      output_map {
        key: "audio"
        value: "AUDIO_WAVEFORM"
      }
    }
  ]
}
