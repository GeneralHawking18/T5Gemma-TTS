name: "tokenizer"
backend: "python"
max_batch_size: 8
input [ 
  { 
    name: "TEXT" 
    data_type: TYPE_STRING 
    dims: [ 1 ] 
  },
  {
    name: "LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
    optional: true
  }
]
output [
  {
    name: "INPUT_IDS"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "ATTENTION_MASK"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "TEXT_LENGTH"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "TARGET_DURATION"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
